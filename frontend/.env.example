# TechJobs Frontend Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
# Use the Vite/nginx same-origin proxy in development and production.
VITE_API_URL=/api
# Jobs are served by /api/jobs. The full feed and credentials stay backend-only.

# PostHog Analytics (Optional)
# Get these from your PostHog project settings: https://app.posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google AdSense (Optional)
# Get these from your AdSense dashboard: https://adsense.google.com
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_BANNER=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_INFEED=
